# Секреты и локальное окружение — никогда не коммитить
.env

# Логи: каждый модуль пишет в logs/<дата>/<канал>.log (единая точка правды — Paths::logs)
logs/

# Файлы сессий (file-драйвер)
storage/sessions/

# Рабочая SQLite-база (путь задаётся DB_DATABASE_PATH)
storage/*.sqlite
*.sqlite

# Флаги состояния движка (создаются инсталлятором/оператором локально)
storage/.installed
storage/.installing
storage/.maintenance
storage/.upgrading
storage/.error

# Артефакты git
*.bundle
vendor/
