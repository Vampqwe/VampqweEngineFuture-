# Режим отладки (true/false)
APP_DEBUG=true

# Часовой пояс
APP_TIMEZONE=Europe/Moscow

# Локаль
APP_LOCALE=ru

# База данных
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vampqwe_engine
DB_USER=root
DB_PASSWORD=

# Кеш
CACHE_DRIVER=file

# Очереди
QUEUE_DRIVER=database

# Логирование
LOG_LEVEL=debug

# Session (file|redis) — при смене драйвера сессии мигрируются автоматически
SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_COOKIE=VSESSID
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_ENCRYPT_COOKIES=true

# Redis (для SESSION_DRIVER=redis и кеша)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
