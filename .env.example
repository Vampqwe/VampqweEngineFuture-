# ═══════════════════════════════════════════════════════════════
#  VampqweEngineFuture — единый эталон конфигурации окружения
#  Скопируйте в .env и заполните значения. Полный список переменных,
#  которые читает ядро (core/, config/, bin/) — ничего лишнего,
#  ничего забытого. Синхронизировано с EnvLoader / Config / Installer.
# ═══════════════════════════════════════════════════════════════

# ── Приложение ──────────────────────────────────────────────────
APP_NAME=VampqweEngineFuture
APP_ENV=production                # production|local (дефолт: production)
APP_DEBUG=false                   # true|false — безопасный дефолт!
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_KEY=                          # 32-байтный ключ шифрования; генерируется Installer'ом (Security::generateKey)

# ── Супер-администратор (единственный, роль универсальная) ──────
SUPER_ADMIN_HASH=                 # argon2id-хеш пароля; записывает Installer на установке

# ── База данных (по умолчанию mysql; остальные драйверы выключены) ──
DB_DRIVER=mysql                   # mysql|sqlite|pgsql
DB_MYSQL_ENABLED=true             # false полностью исключает драйвер
DB_SQLITE_ENABLED=false
DB_PGSQL_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vampqwe_engine
DB_USER=root
DB_PASSWORD=
DB_DATABASE_PATH=                 # только для DB_DRIVER=sqlite; путь отн. storage/ или абс. (Installer пишет сюда)

# ── Кеш (модуль Cache: file|array|redis; redis требует ext-redis + CACHE_REDIS_ENABLED=true) ──
CACHE_DRIVER=file                 # file|redis|array
CACHE_PREFIX=engine               # префикс ключей в redis
CACHE_TTL=3600                    # TTL по умолчанию для set(), сек
CACHE_REDIS_ENABLED=false         # =1 включает redis-стор (при недоступности — деградация в file)
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0

# ── Очереди (модуль Queue: file|redis; worker: php bin/engine queue:work) ──
QUEUE_DRIVER=file                 # file|redis
QUEUE_MAX_ATTEMPTS=3              # попыток выполнения до переноса в failed/
QUEUE_RETRY_AFTER=60              # базовая задержка retry, сек
QUEUE_VISIBILITY=30               # «видимость» задачи при резервации, сек
QUEUE_REDIS_ENABLED=false         # =1 включает redis-бэкенд (при недоступности — деградация в file)
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=0
QUEUE_REDIS_LIST=engine:queue

# ── Логирование ─────────────────────────────────────────────────
LOG_LEVEL=debug                   # debug|info|warning|error|critical

# ── Сессии и куки (file|redis; при смене драйвера сессии мигрируются автоматически) ──
SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_COOKIE=VSESSID
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_ENCRYPT_COOKIES=true

# ── Redis (используется SESSION_DRIVER=redis и CACHE_DRIVER=redis) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Служебное ───────────────────────────────────────────────────
ENV_OVERRIDE=                     # =1 разрешает переменным shell перекрывать .env (Docker/CI); по умолчанию .env сильнее
