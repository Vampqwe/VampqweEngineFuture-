# Режим отладки (true/false)
APP_DEBUG=true

# Часовой пояс
APP_TIMEZONE=Europe/Moscow

# Локаль
APP_LOCALE=ru

# База данных
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vampqwe_engine
DB_USER=root
DB_PASSWORD=

# Кеш
CACHE_DRIVER=file

# Очереди
QUEUE_DRIVER=database

# Логирование
LOG_LEVEL=debug
