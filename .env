# ═══════════════════════════════════════════════════════════════════
#  VampqweEngineFuture — ЭТАЛОН конфигурации окружения (.env)
# ───────────────────────────────────────────────────────────────────
#  Как пользоваться:
#    1. Скопируйте этот файл:            cp .env.example .env
#    2. Заполните значения под свой сервер (или запустите Installer —
#       он создаст .env сам и сгенерирует APP_KEY / SUPER_ADMIN_HASH).
#    3. НИКОГДА не коммитьте .env в git — только этот .env.example.
#
#  Правила парсинга:
#    • Формат КЛЮЧ=ЗНАЧЕНИЕ, пробелы вокруг «=» допустимы.
#    • Строки после «#» на отдельной линии или в конце строки — комментарий.
#    • Пустое значение (КЛЮЧ=) означает «не задано» → ядро применит дефолт.
#    • Значения в кавычках НЕ поддерживаются — пишите без кавычек.
#    • Логические флаги: true|false (регистр не важен), также принимаются 1/0.
#    • По умолчанию .env сильнее переменных окружения shell; чтобы shell
#      мог перекрывать .env (Docker/CI) — включите ENV_OVERRIDE (см. ниже).
#
#  Полнота: список ниже = исчерпывающий. Ядро читает РОВНО эти переменные
#  (проверено grep'ом по core/, config/, bin/, app/). Ничего лишнего,
#  ничего забытого. Синхронизировано с EnvLoader / Config / Installer.
# ═══════════════════════════════════════════════════════════════════

# ── Приложение ──────────────────────────────────────────────────────
# Отображаемое имя движка/сайта (заголовки, письма, виджет Doctor'а).
APP_NAME=VampqweEngineFuture

# Показывать подробности ошибок конечному пользователю?
# В production держите false! Дефолт при отсутствии: false.
APP_DEBUG=false

# Часовой пояс (любая валидная строка tz-базы PHP: Europe/Moscow, UTC...).
APP_TIMEZONE=Europe/Moscow

# Локаль интерфейса/форматов (ru, en...). Используется форматёрами дат.
APP_LOCALE=ru

# 32-байтный ключ шифрования (подпись куки-сессий и прочее).
# САМОСТОЯТЕЛЬНО НЕ ПРИДУМЫВАЙТЕ — генерирует Installer (Security::generateKey)
# либо CLI после установки. Пустой = установка ещё не выполнена.
APP_KEY=

# Тема оформления сайта по умолчанию для НОВЫХ сайтов реестра
# (см. SiteRegistry; конкретный домен может иметь свою тему).
# Дефолт при отсутствии: _default.
APP_THEME=_default

# Кешировать ли компилированные шаблоны (storage/template-cache).
# false — перечитывать .phtml при каждом запросе (режим разработки).
TEMPLATE_CACHE=true

# ── Супер-администратор (п. Конституции: единственный, роль универсальная) ─
# argon2id-хеш пароля супер-админа. НЕ плагин и НЕ текст пароля!
# Записывает Installer на установке. Пустой = вход в админку невозможен
# (Doctor подсветит это как критическую проблему).
SUPER_ADMIN_HASH=

# ── База данных ─────────────────────────────────────────────────────
# Активный драйвер: mysql | sqlite | pgsql.
# Должен соответствовать одному из включённых ниже *_ENABLED-драйверов.
DB_DRIVER=sqlite

# Флаги доступности драйверов: false ПОЛНОСТЬЮ исключает драйвер из ядра
# (даже код адаптера не загружается). Оставьте включённым только нужный.
DB_MYSQL_ENABLED=false
DB_SQLITE_ENABLED=true
DB_PGSQL_ENABLED=false

# Параметры соединения (для DB_DRIVER=mysql и pgsql).
DB_HOST=localhost
DB_PORT=3306                      # mysql: 3306, pgsql: обычно 5432
DB_NAME=vampqwe_engine
DB_USER=root
DB_PASSWORD=

# Путь файла SQLite — ТОЛЬКО для DB_DRIVER=sqlite.
# Относительный — от storage/, либо абсолютный. Installer заполняет сам.
# Пример: DB_DATABASE_PATH=database/engine.sqlite
DB_DATABASE_PATH=

# ── Кеш (модуль Cache) ──────────────────────────────────────────────
# Бэкенд кеша: file | redis | array (array — только для тестов, всё в памяти).
CACHE_DRIVER=file

# Префикс ключей (важно при общем redis с другими проектами).
CACHE_PREFIX=engine

# TTL по умолчанию для set() без явного времени, в секундах.
CACHE_TTL=3600

# Redis-стор для кеша. Требуется ext-redis; при недоступности сервера —
# автоматическая деградация на file (движок не падает, п. Конституции).
CACHE_REDIS_ENABLED=false
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0

# ── Очереди (модуль Queue; воркер: php bin/engine queue:work) ───────
# Бэкенд очереди: file | redis.
QUEUE_DRIVER=file

# Сколько попыток выполнения задачи перед переносом в failed/.
QUEUE_MAX_ATTEMPTS=3

# Базовая задержка перед повтором неудачной задачи, сек (экспоненциально).
QUEUE_RETRY_AFTER=60

# Время «резервации» задачи воркером, сек: если воркер умер, задача
# вернётся в очередь через этот интервал.
QUEUE_VISIBILITY=30

# Redis-бэкенд очереди (=true требует CACHE_REDIS_* не обязательно —
# свои параметры ниже; при недоступности — деградация на file).
QUEUE_REDIS_ENABLED=false
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=0
QUEUE_REDIS_LIST=engine:queue     # имя списка (LPUSH/BRPOP)

# ── Логирование ─────────────────────────────────────────────────────
# Минимальный уровень пишущихся событий: debug|info|warning|error|critical.
# Логи: storage/logs/<дата>/<Модуль>.log (п. Конституции о наблюдаемости).
LOG_LEVEL=debug

# ── Сессии и куки ───────────────────────────────────────────────────
# Хранилище сессий: file | redis (миграция при смене — автоматическая).
SESSION_DRIVER=file

# Жизнь сессии без активности, сек (7200 = 2 часа).
SESSION_LIFETIME=7200

# Имя cookie идентификатора сессии.
SESSION_COOKIE=VSESSID

# Домен cookie: пусто = текущий хост (для мультисайта обычно пусто);
# .example.com — расшарить между поддоменами.
SESSION_DOMAIN=

# HTTPS-only cookie. Ставьте true, когда сайт работает по TLS.
SESSION_SECURE=false

# Защита от CSRF-межсайтовых запросов: Strict|Lax|None
# (None требует SESSION_SECURE=true, иначе браузер проигнорирует).
SESSION_SAME_SITE=Lax

# Шифровать содержимое сессионной куки ключом APP_KEY (рекомендуется true).
SESSION_ENCRYPT_COOKIES=true

# ── Redis (общие параметры; используются SESSION_DRIVER=redis) ──────
# Внимание: кеш и очередь имеют СОБСТВЕННЫЕ redis-параметры (секции выше) —
# здесь задаётся только redis для сессий.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Служебное ───────────────────────────────────────────────────────
# Разрешить переменным shell/Docker перекрывать значения из .env.
# true — env процесса важнее файла (удобно в CI/контейнерах).
# Пусто/false — .env сильнее (безопасный дефолт: конфиг один и локален).
ENV_OVERRIDE=

# ═══════════════════════════════════════════════════════════════════
#  НЕ выносится в .env осознанно (и это не oversight):
#   • Пути проекта — канон в Paths::MAP (п.7 Конституции), настройке не подлежат.
#   • Порядок загрузки модулей — манифест config/modules.php.
#   • Системные маршруты (/admin, /install, /login...) — зашиты в Kernel (п.3).
#   • Секретные значения вне .env запрещены; но пароли БД хранятся здесь —
#     держите права файла .env в 600 и не выносите его за пределы сервера.
# ═══════════════════════════════════════════════════════════════════
