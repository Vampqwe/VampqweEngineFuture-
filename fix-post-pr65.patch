From 19f36c2a1bebd5b59bb1d55a8bf0dcd0ba6cc457 Mon Sep 17 00:00:00 2001
From: "qwen.ai[bot]" <qwenlm-intl@service.alibaba.com>
Date: Thu, 29 Oct 2026 12:58:52 +0000
Subject: [PATCH 2/2] fix(installer): pass explicit empty content to createFile
 per contract (R11)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

KernelInstallGuardTest::testInstalledFlagIsSetBeforeDatabaseSteps failed:
Installer called FileSystemInterface::createFile($flag) with one argument,
while the contract declares two required parameters (no defaults in public
contracts — rule R11). Fixed on the caller side (contract stays strict):
both flag-file creations now pass '' explicitly with a comment explaining
the invariant.
---
 core/Module/Installer/Installer.php | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/core/Module/Installer/Installer.php b/core/Module/Installer/Installer.php
index 199aa9c..73e3e31 100644
--- a/core/Module/Installer/Installer.php
+++ b/core/Module/Installer/Installer.php
@@ -94,7 +94,9 @@ final class Installer implements InstallerInterface, InstallerPageInterface
     public function install(array $options = []): array|bool
     {
         $flagFile = $this->flagPath(AppState::Installing);
-        $this->fs->createFile($flagFile);
+        // Контракт FileSystemInterface::createFile требует явный аргумент $content (R11 —
+        // дефолтов в контрактах нет): флаг-файл создаётся пустой строкой осознанно.
+        $this->fs->createFile($flagFile, '');
         $summary = [];
 
         try {
@@ -129,7 +131,7 @@ final class Installer implements InstallerInterface, InstallerPageInterface
             }
 
             // Флаг готовности — AppState::Running определяется по нему
-            $this->fs->createFile($this->flagPath(AppState::Running));
+            $this->fs->createFile($this->flagPath(AppState::Running), '');
 
             // Database-шаг: создаём БД (если активный драйвер включён и доступен)
             // и прогоняем схему database/db.sql. Недоступная СУБД НЕ валит установку —
